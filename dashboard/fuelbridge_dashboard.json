          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT\n  to_char(executado_em, 'DD/MM/YYYY HH24:MI:SS') AS \"Executado em\",\n  CASE combustivel_id WHEN 'DIESEL' THEN 'Gasóleo' WHEN 'GASOLINA_95' THEN 'Gasolina 95' ELSE combustivel_id END AS \"Combustível\",\n  preco_pt AS \"Preço PT (EUR)\",\n  preco_br AS \"Preço BR (EUR)\",\n  n_pt AS \"Postos PT\",\n  n_br AS \"Registos BR\",\n  dif_eur AS \"Diferença (EUR)\",\n  dif_pct AS \"Diferença (%)\",\n  razao AS \"Razão PT/BR\"\nFROM comparacao\nORDER BY executado_em DESC, combustivel_id\nLIMIT 50;"
        }
