        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bg1c0yhazaneob"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT\n  CASE combustivel_id WHEN 'DIESEL' THEN 'Gasóleo' WHEN 'GASOLINA_95' THEN 'Gasolina 95' ELSE combustivel_id END AS \"Combustível\",\n  preco_pt AS \"Portugal\",\n  preco_br AS \"Brasil\"\nFROM v_comparacao_atual\nORDER BY combustivel_id;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 3,
          "color": {
            "mode": "palette-classic"
          }
        },
