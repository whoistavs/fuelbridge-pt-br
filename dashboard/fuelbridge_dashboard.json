      "id": 1,
      "type": "stat",
      "title": "Quanto mais caro em Portugal (%)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bg1c0yhazaneob"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bg1c0yhazaneob"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT\n  MAX(CASE WHEN combustivel_id = 'DIESEL' THEN dif_pct END)      AS \"Gasóleo\",\n  MAX(CASE WHEN combustivel_id = 'GASOLINA_95' THEN dif_pct END) AS \"Gasolina 95\"\nFROM v_comparacao_atual;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "justifyMode": "auto"
      }
    },
