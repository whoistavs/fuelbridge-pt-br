    {
      "id": 5,
      "type": "timeseries",
      "title": "Preço médio semanal (EUR/L)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bg1c0yhazaneob"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bg1c0yhazaneob"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT\n  to_date(ano::text || '-' || semana::text || '-1', 'IYYY-IW-ID')::timestamp AS time,\n  pais || ' - ' || CASE combustivel_id WHEN 'DIESEL' THEN 'Gasóleo' WHEN 'GASOLINA_95' THEN 'Gasolina 95' ELSE combustivel_id END AS metric,\n  preco_medio_eur AS value\nFROM v_preco_semanal\nWHERE combustivel_id IN ('DIESEL', 'GASOLINA_95')\nORDER BY 1;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 3,
          "custom": {
